	path = development/services/mcp/desktop-notify
	url = https://github.com/Cactusinhand/mcp_server_notify.git

[submodule "development/services/mcp/yepcode"]
	path = development/services/mcp/yepcode
	url = https://github.com/yepcode/mcp-server-js.git

[submodule "projects/active/ghidra"]
	path = projects/active/ghidra
	url = https://github.com/NationalSecurityAgency/ghidra.git

[submodule "projects/active/marker"]
	path = projects/active/marker
