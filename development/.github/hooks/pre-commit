#!/bin/bash
#
# Pre-commit hook to enforce documentation freeze.
#
# Installed: 2025-10-14 (originally a 2-week window ending 2025-10-28).
# Re-enabled indefinitely on 2026-04-26 (commit 1c4f807b) after the
# original end date had passed; intent is now an open-ended policy
# rather than a time-boxed one. Flip FREEZE_ACTIVE=false to disable.
#
# This hook blocks commits that add new documentation files matching
# the FORBIDDEN_PATTERNS list, with archives/** and **/docs/** exempt.
# See CORE_PROJECTS.md for the freeze policy.

FREEZE_ACTIVE=true

# Path globs exempt from the freeze (regex form, evaluated with bash =~).
# Files matching ANY of these are skipped from violation checks AND warnings.
# Maintained as regexes so they can be ORed together inline below.
EXEMPT_PATH_REGEX_ARCHIVES='(^|/)archives/'
EXEMPT_PATH_REGEX_DOCS='(^|/)docs/'

# ANSI color codes
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Get list of files being committed
FILES=$(git diff --cached --name-only --diff-filter=A)

# Forbidden patterns for new files
FORBIDDEN_PATTERNS=(
    "PLAN"
    "STATUS"
    "ANALYSIS"
    "ROADMAP"
    "CLEANUP"
    "CONSOLIDATION"
    "ORGANIZATION"
    "DEPLOYMENT"
    "IMPLEMENTATION"
    "REPORT"
    "GUIDE"
    "INDEX"
    "REVIEW"
    "INVESTIGATION"
    "CHECKLIST"
    "RUNBOOK"
    "VALIDATION"
)

# Check if freeze is active
if [ "$FREEZE_ACTIVE" = true ]; then
    echo -e "${YELLOW}📜 Documentation Freeze Active${NC}"

    VIOLATIONS=()

    for file in $FILES; do
        # Check if file is markdown in root or project root
        if [[ $file =~ \.md$ ]] \
            && [[ ! $file =~ development/ml-sectest-framework/(README|CHANGELOG)\.md$ ]] \
            && [[ ! $file =~ development/saas/README\.md$ ]] \
            && [[ ! $file =~ development/GhidraGo/README\.md$ ]] \
            && [[ ! $file =~ projects/platform/mcp-gateway/README\.md$ ]] \
            && [[ ! $file =~ $EXEMPT_PATH_REGEX_ARCHIVES ]] \
            && [[ ! $file =~ $EXEMPT_PATH_REGEX_DOCS ]]; then

            # Check for forbidden patterns in filename
            for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
                if [[ $file =~ $pattern ]]; then
                    VIOLATIONS+=("$file (contains '$pattern')")
                    break
                fi
            done

            # Check if it's a new root-level markdown
            if [[ $file =~ ^[^/]+\.md$ ]] && [[ ! $file =~ ^(README|CHANGELOG|LICENSE|CORE_PROJECTS)\.md$ ]]; then
                VIOLATIONS+=("$file (new root-level .md file)")
            fi
        fi
    done

    if [ ${#VIOLATIONS[@]} -gt 0 ]; then
        echo -e "${RED}❌ COMMIT BLOCKED - Documentation Freeze Violation${NC}"
        echo ""
        echo "The following files violate the documentation freeze:"
        for violation in "${VIOLATIONS[@]}"; do
            echo -e "  ${RED}✗${NC} $violation"
        done
        echo ""
        echo -e "${YELLOW}Documentation Freeze Rules:${NC}"
        echo "  ✓ Use GitHub Issues for planning and tracking"
        echo "  ✓ Use code comments for inline documentation"
        echo "  ✓ Update existing README.md files only (1 per project)"
        echo "  ✗ No new planning/status/analysis documents"
        echo ""
        echo "See CORE_PROJECTS.md for complete freeze policy"
        echo ""
        echo -e "${YELLOW}To override (NOT RECOMMENDED):${NC}"
        echo "  git commit --no-verify -m \"your message\""
        exit 1
    fi
fi

# Check for untracked files matching forbidden patterns
UNTRACKED=$(git ls-files --others --exclude-standard | grep '\.md$')
if [ ! -z "$UNTRACKED" ]; then
    WARNING_FILES=()
    for file in $UNTRACKED; do
        for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
            if [[ $file =~ $pattern ]]; then
                WARNING_FILES+=("$file")
                break
            fi
        done
    done

    # Filter out exempt paths (archives/**, **/docs/**) from warnings.
    FILTERED_WARNINGS=()
    for file in "${WARNING_FILES[@]}"; do
        if [[ ! $file =~ $EXEMPT_PATH_REGEX_ARCHIVES ]] && [[ ! $file =~ $EXEMPT_PATH_REGEX_DOCS ]]; then
            FILTERED_WARNINGS+=("$file")
        fi
    done
    WARNING_FILES=("${FILTERED_WARNINGS[@]}")

    if [ ${#WARNING_FILES[@]} -gt 0 ]; then
        echo -e "${YELLOW}⚠️  Warning: Untracked documentation files detected${NC}"
        for file in "${WARNING_FILES[@]}"; do
            echo -e "  ${YELLOW}!${NC} $file"
        done
        echo -e "Consider adding these to .gitignore or removing them"
        echo ""
    fi
fi

echo -e "${GREEN}✓ Pre-commit checks passed${NC}"
exit 0
