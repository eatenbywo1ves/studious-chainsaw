# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
#
# CRITICAL: This file contains templates for production environment variables.
# Follow the setup instructions below to generate secure values.
#
# Created: 2025-10-23
# Based on: Pydantic Configuration Migration (Phase 1)
# Related: MIGRATION_REPORTS_REVIEW.md, PRODUCTION_DEPLOYMENT_CHECKLIST.md
# ============================================================================

# ============================================================================
# STEP 1: GENERATE SECURE SECRETS (RUN THIS FIRST)
# ============================================================================
# Run the companion script to generate secure random values:
#   python generate_production_secrets.py
#
# Or manually generate using Python:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ============================================================================

# ============================================================================
# JWT AUTHENTICATION (CRITICAL - MUST SET)
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER use the default value in production!
JWT_SECRET_KEY=__REPLACE_WITH_SECURE_64_BYTE_SECRET__

# Algorithm: RS256 (RSA) recommended for production, HS256 for development
JWT_ALGORITHM=RS256

# Token expiration times (in minutes for access, days for refresh)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# RSA Key Configuration (Required if JWT_ALGORITHM=RS256)
# Generate RSA keys with: ssh-keygen -t rsa -b 4096 -m PEM -f jwt_rsa
JWT_PRIVATE_KEY_PATH=/etc/secrets/jwt_rsa
JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt_rsa.pub

# API Key Configuration
API_KEY_PREFIX=catalytic_
API_KEY_LENGTH=32

# ============================================================================
# DATABASE CONFIGURATION (CRITICAL - MUST SET)
# ============================================================================
# Production: PostgreSQL strongly recommended
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://catalytic_user:__REPLACE_PASSWORD__@localhost:5432/catalytic_saas_prod

# Connection Pool Settings (tuned for production load)
DATABASE_POOL_SIZE=50
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# ============================================================================
# REDIS CONFIGURATION (CRITICAL - MUST SET)
# ============================================================================
# Format: redis://[:password@]host:port/db
REDIS_URL=redis://:__REPLACE_PASSWORD__@localhost:6379/0

# Connection Pool Settings
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Circuit Breaker Settings (for resilience)
REDIS_CIRCUIT_BREAKER_ENABLED=true
REDIS_FAILURE_THRESHOLD=5
REDIS_RECOVERY_TIMEOUT=60
REDIS_EXPECTED_EXCEPTION_TYPES=redis.exceptions.ConnectionError,redis.exceptions.TimeoutError

# ============================================================================
# EMAIL CONFIGURATION (REQUIRED FOR USER NOTIFICATIONS)
# ============================================================================
# Provider: sendgrid, aws_ses, or smtp
EMAIL_PROVIDER=sendgrid

# SendGrid Configuration (recommended for production)
SENDGRID_API_KEY=__REPLACE_WITH_SENDGRID_KEY__

# AWS SES Configuration (alternative)
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=__REPLACE_WITH_AWS_KEY__
AWS_SECRET_ACCESS_KEY=__REPLACE_WITH_AWS_SECRET__

# SMTP Configuration (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=__REPLACE_WITH_SMTP_USER__
SMTP_PASSWORD=__REPLACE_WITH_SMTP_PASSWORD__
SMTP_USE_TLS=true

# Email Defaults
DEFAULT_FROM_EMAIL=noreply@catalytic-saas.com
DEFAULT_FROM_NAME=Catalytic SaaS

# ============================================================================
# STRIPE PAYMENT CONFIGURATION (REQUIRED FOR BILLING)
# ============================================================================
STRIPE_SECRET_KEY=sk_live___REPLACE_WITH_LIVE_KEY__
STRIPE_PUBLISHABLE_KEY=pk_live___REPLACE_WITH_LIVE_KEY__
STRIPE_WEBHOOK_SECRET=whsec___REPLACE_WITH_WEBHOOK_SECRET__

# Stripe Price IDs (create in Stripe dashboard)
STRIPE_BASIC_PRICE_ID=price_XXXXXXXXXXXXX
STRIPE_PRO_PRICE_ID=price_XXXXXXXXXXXXX
STRIPE_ENTERPRISE_PRICE_ID=price_XXXXXXXXXXXXX

# ============================================================================
# SECURITY CONFIGURATION (CRITICAL)
# ============================================================================
# Application Environment
APP_ENV=production

# CORS Settings (restrict to your frontend domains)
CORS_ORIGINS=https://app.catalytic-saas.com,https://catalytic-saas.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Security Headers
SECURE_HEADERS_ENABLED=true
HTTPS_ONLY=true

# Session Configuration
SESSION_SECRET_KEY=__REPLACE_WITH_SECURE_SECRET__
SESSION_MAX_AGE=86400

# ============================================================================
# MONITORING & LOGGING (RECOMMENDED)
# ============================================================================
# Logging Level (ERROR for production, WARNING for staging)
LOG_LEVEL=ERROR
LOG_FORMAT=json

# Sentry Error Tracking (recommended)
SENTRY_DSN=https://___@sentry.io/___
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Datadog APM (optional)
DD_AGENT_HOST=localhost
DD_TRACE_ENABLED=true
DD_ENV=production
DD_SERVICE=catalytic-saas

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# API Configuration
API_TITLE=Catalytic SaaS API
API_VERSION=1.0.0
API_PREFIX=/api/v1

# Worker Configuration (for multi-worker deployments)
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_TIMEOUT=120

# ============================================================================
# OPTIONAL INTEGRATIONS
# ============================================================================
# AWS S3 for file storage
AWS_S3_BUCKET=catalytic-saas-prod
AWS_S3_REGION=us-east-1

# OpenAI API (if using AI features)
OPENAI_API_KEY=sk-___REPLACE___

# ============================================================================
# DEPLOYMENT VERIFICATION CHECKLIST
# ============================================================================
# Before deploying to production, verify:
#
# [ ] All __REPLACE_*__ placeholders have been replaced with real values
# [ ] JWT_SECRET_KEY is a cryptographically secure random string (64+ bytes)
# [ ] DATABASE_URL points to PostgreSQL (not SQLite)
# [ ] REDIS_URL includes a strong password
# [ ] Email provider is configured and tested
# [ ] Stripe keys are LIVE keys (sk_live_*, pk_live_*)
# [ ] CORS_ORIGINS includes only your actual domains (no wildcards)
# [ ] APP_ENV is set to "production"
# [ ] HTTPS_ONLY is set to true
# [ ] All secrets are stored in secure secret management (not in git)
# [ ] Backup of this configuration exists in secure location
# [ ] Monitoring (Sentry/Datadog) is configured
#
# See PRODUCTION_DEPLOYMENT_CHECKLIST.md for complete deployment guide
# ============================================================================
