# ============================================================================
# CATALYTIC COMPUTING SAAS - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Deployment environment: development, staging, production, testing
APP_ENV=development
DEPLOYMENT_ENV=development  # Legacy support

# Application metadata
APP_NAME=Catalytic Computing SaaS
APP_DEBUG=true
APP_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Server configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1  # Increase for production (typically 2-4)

# Application URLs
APP_FRONTEND_URL=http://localhost:3000
APP_BACKEND_URL=http://localhost:8000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database connection URL
# SQLite (development):
DATABASE_URL=sqlite:///./catalytic_saas.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# PostgreSQL connection pool settings (ignored for SQLite)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false  # Set to true to log all SQL queries

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Leave empty if no password
REDIS_DB=0

# Redis connection pool
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_DECODE_RESPONSES=true

# Redis circuit breaker
REDIS_CIRCUIT_BREAKER_ENABLED=true
REDIS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
REDIS_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# ============================================================================
# AUTHENTICATION & JWT CONFIGURATION
# ============================================================================

# CRITICAL: JWT Secret Key
# - MUST be set in production
# - Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# - Keep this secret and rotate regularly
JWT_SECRET_KEY=

# JWT Algorithm: RS256 (RSA) or HS256 (HMAC)
JWT_ALGORITHM=RS256

# RSA Key Paths (for RS256 algorithm)
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# Token expiration
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15  # 15 minutes
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30    # 30 days

# API Key settings
JWT_API_KEY_PREFIX=clc_

# Session configuration
JWT_SESSION_SECRET_KEY=
JWT_SESSION_COOKIE_SECURE=true
JWT_SESSION_COOKIE_HTTPONLY=true
JWT_SESSION_COOKIE_SAMESITE=strict

# CSRF Protection
JWT_CSRF_ENABLED=true
JWT_CSRF_SECRET_KEY=

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Security level: basic, enhanced, strict
SECURITY_LEVEL=enhanced

# Encryption keys
API_ENCRYPTION_KEY_PATH=keys/api_encryption.key
DB_ENCRYPTION_KEY_PATH=keys/db_encryption.key

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# DDoS Protection
DDOS_PROTECTION_ENABLED=true
DDOS_BLOCK_DURATION_MINUTES=60

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# CORS settings
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=*
CORS_MAX_AGE=600

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# Common settings
EMAIL_FROM=noreply@catalyticcomputing.com
EMAIL_FROM_NAME=Catalytic Computing

# Option 1: SendGrid (recommended for production)
SENDGRID_API_KEY=

# Option 2: AWS SES
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Option 3: SMTP (fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ============================================================================
# STRIPE PAYMENT CONFIGURATION
# ============================================================================

# Stripe keys (get from https://dashboard.stripe.com/apikeys)
# Test mode keys start with sk_test_ and pk_test_
# Live mode keys start with sk_live_ and pk_live_
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Sentry error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# GPU acceleration
ENABLE_GPU_ACCELERATION=false
GPU_DEVICE_ID=0

# Experimental features
ENABLE_REACTIVE_AUTH=false
ENABLE_ADVANCED_ANALYTICS=false

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Hot reload for development
RELOAD=true

# Profiling
ENABLE_PROFILING=false

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================

# Test database (used when APP_ENV=testing)
TEST_DATABASE_URL=sqlite:///./test_catalytic.db

# Skip slow tests
SKIP_SLOW_TESTS=false

# ============================================================================
# NOTES
# ============================================================================
#
# Environment Variable Priority:
# 1. Actual environment variables
# 2. .env file
# 3. Default values in code
#
# Security Best Practices:
# - Never commit .env to version control
# - Use different values for each environment
# - Rotate secrets regularly
# - Use secrets management in production (AWS Secrets Manager, Vault, etc.)
#
# Required Variables by Environment:
# 
# Development:
# - DATABASE_URL (defaults to SQLite)
# - REDIS_HOST (defaults to localhost)
#
# Production:
# - JWT_SECRET_KEY (REQUIRED)
# - DATABASE_URL (must be PostgreSQL)
# - REDIS_PASSWORD (REQUIRED)
# - All encryption key paths
#
# ============================================================================
