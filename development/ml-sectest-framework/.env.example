# ML-SecTest Framework - Environment Configuration
# ===================================================
# Copy this file to .env and customize for your environment
# IMPORTANT: Never commit .env to version control!

# ============================================================================
# API Server Configuration
# ============================================================================

# API server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
API_HOST=0.0.0.0

# API server port
API_PORT=8081

# Number of Uvicorn workers (production: 2-4, development: 1)
API_WORKERS=1

# Enable auto-reload (development only, set to false in production)
API_RELOAD=false

# API title and version
API_TITLE=ML-SecTest API
API_VERSION=1.0.0

# ============================================================================
# CORS Configuration
# ============================================================================

# Comma-separated list of allowed origins (no spaces!)
# Development example:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Production example:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://dashboard.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# Allow credentials (cookies) in CORS requests
CORS_ALLOW_CREDENTIALS=true

# CORS preflight cache duration (seconds)
CORS_MAX_AGE=600

# ============================================================================
# Rate Limiting
# ============================================================================

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Number of requests per window
RATE_LIMIT_REQUESTS=10

# Window duration (second/minute/hour/day)
RATE_LIMIT_WINDOW=minute

# ============================================================================
# Database Configuration
# ============================================================================

# Database type (sqlite or postgresql)
DATABASE_TYPE=sqlite

# Full database URL (overrides other DB settings if provided)
# SQLite: sqlite:///data/ml_sectest.db
# PostgreSQL: postgresql://user:password@localhost:5432/ml_sectest
# DATABASE_URL=

# SQLite configuration
SQLITE_DB_PATH=data/ml_sectest.db

# PostgreSQL configuration (only used if DATABASE_TYPE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ml_sectest
POSTGRES_USER=ml_sectest
POSTGRES_PASSWORD=changeme

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Log file path (leave empty for stdout only)
# LOG_FILE=logs/ml_sectest.log

# ============================================================================
# Security Configuration
# ============================================================================

# Secret key for signing tokens (MUST be random and secure in production!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=insecure-development-key-change-in-production

# Enable API key authentication
API_KEY_ENABLED=false

# Comma-separated list of valid API keys
# API_KEYS=key1,key2,key3

# ============================================================================
# Scanning Configuration
# ============================================================================

# Default scan timeout (seconds)
SCAN_DEFAULT_TIMEOUT=300

# Maximum number of concurrent scans
SCAN_MAX_CONCURRENT=5

# Directory for scan reports
SCAN_REPORTS_DIR=reports

# ============================================================================
# Prometheus Metrics
# ============================================================================

# Enable Prometheus metrics endpoint
METRICS_ENABLED=true

# Prometheus metrics port (if running separate metrics server)
METRICS_PORT=9090

# ============================================================================
# Environment & Debug
# ============================================================================

# Environment name (development/staging/production)
ENVIRONMENT=development

# Enable debug mode (development only!)
DEBUG=false

# ============================================================================
# Production Deployment Checklist
# ============================================================================
# Before deploying to production, ensure:
#
# 1. SECRET_KEY is set to a secure random value
# 2. DEBUG=false
# 3. ENVIRONMENT=production
# 4. CORS_ALLOWED_ORIGINS contains only your production domains
# 5. DATABASE credentials are secure
# 6. API_RELOAD=false
# 7. LOG_LEVEL=INFO or WARNING
# 8. API_KEY_ENABLED=true (if using API keys)
# 9. RATE_LIMIT settings are appropriate for your traffic
# 10. .env file has restricted permissions (chmod 600 .env)
