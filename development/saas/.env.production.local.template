# ============================================================================
# SECURITY - CRITICAL SECRETS (SEC-001 Fix)
# ============================================================================

# Redis Password (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This was previously hardcoded in deploy scripts - now loaded securely
REDIS_PASSWORD=

# JWT Secret Key (REQUIRED - SEC-002 Fix)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 32 bytes required. Application will fail to start if not set.
JWT_SECRET_KEY=

# Database Password (REQUIRED)
# For production PostgreSQL
DATABASE_PASSWORD=

# ============================================================================
# EXTERNAL API KEYS
# ============================================================================

# Stripe API Keys
STRIPE_SECRET_KEY=sk_live_
STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_WEBHOOK_SECRET=whsec_

# SendGrid API Key
SENDGRID_API_KEY=SG.

# Sentry DSN (Optional - for error monitoring)
SENTRY_DSN=

# ============================================================================
# SESSION & CSRF (SEC-010 Future Implementation)
# ============================================================================

# Session Secret (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET_KEY=

# CSRF Secret (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
CSRF_SECRET_KEY=

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file to .env.production.local:
#    cp .env.production.local.template .env.production.local
#
# 2. Generate secure secrets:
#    python -c "import secrets; print('REDIS_PASSWORD=' + secrets.token_urlsafe(32))" >> .env.production.local
#    python -c "import secrets; print('JWT_SECRET_KEY=' + secrets.token_urlsafe(32))" >> .env.production.local
#
# 3. Add your API keys and other secrets
#
# 4. Verify .env.production.local is gitignored:
#    git check-ignore .env.production.local
#    # Should output: .env.production.local
#
# 5. Set appropriate file permissions (Linux/Mac):
#    chmod 600 .env.production.local
#
# ============================================================================
